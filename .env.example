# Copy to apps/api/.env (API) and apps/web/.env.local (web). Never commit real values.

# --- API ---
DATABASE_URL="postgresql://workshop:workshop@localhost:5433/workshop"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Dev-only seeded admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@workshops.local"
SEED_ADMIN_PASSWORD="Admin123!dev"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
